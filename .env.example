# Copy to .env and fill in. Never commit .env.

# local | test | staging | production
APP_ENV=local
LOG_LEVEL=INFO
# true in containers; false gives readable console logs
LOG_JSON=false

# SQLite needs no setup. For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./data/jev_invoice.db
# Only needed for the background worker (arq):
# REDIS_URL=redis://localhost:6379/0

# ── Extraction LLM: Groq ─────────────────────────────────────────────────────
# https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Vision model for scans and photos (same Groq key). Leave empty to disable.
VISION_MODEL=qwen/qwen3.8-27b
# VISION_MAX_PAGES=5
# Or read scans on this machine with Ollama (free, private, slower on a CPU):
#   ollama pull glm-ocr:q8_0
# VISION_PROVIDER=ollama
# VISION_MODEL=glm-ocr:q8_0
# OLLAMA_BASE_URL=http://localhost:11434
# Spend cap per UTC day; extraction pauses when reached.
# LLM_DAILY_BUDGET_USD=5.00

# ── Decision model: TypeSafe Jev ─────────────────────────────────────────────
# Without a key the app still runs, but every invoice goes to human review.
TYPESAFE_API_KEY=
# Direct from TypeSafe (https://typesafe.ai): leave TYPESAFE_BASE_URL unset.
TYPESAFE_MODEL=jev-1.13.0
# Through BeatAPI (https://beatapi.io/jev-api), same API, BeatAPI key:
# TYPESAFE_BASE_URL=https://api.beatapi.io
# TYPESAFE_MODEL=jev-1.13-free
# JEV_COST_PER_INPUT_TOKEN_USD=0
# jev-1.13-free allows 1 call per minute before a top-up (10/min after).
# Over the limit, decisions fail closed: the invoice goes to human review.

# ── Business rules ───────────────────────────────────────────────────────────
# Totals above this need a budget owner's approval (in USD, the base currency).
# APPROVAL_LIMIT=5000.00
# How far an invoice may exceed the PO / received value, in percent.
# PO_PRICE_TOLERANCE_PCT=2.0

# HMAC key for bank-account fingerprints. Optional locally; required in staging/production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# BANK_FINGERPRINT_KEY=
